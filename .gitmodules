; Module submodule set inherited from logos-modules@bump.
;
; The 13 submodules below mirror the bump branch of the legacy
; logos-modules repo at the time of v2 bootstrap. Per-module releases
; track their own SHAs from here forward — bump a submodule pointer
; here and run the matching .github/workflows/release-<repo>.yml
; workflow to publish a new <name>-v<version> release.
;
; After cloning, run:
;   git submodule update --init --recursive
; to materialise the submodule working trees.

[submodule "logos-accounts-module"]
	path = submodules/logos-accounts-module
	url = https://github.com/logos-co/logos-accounts-module
	branch = master

[submodule "logos-accounts-ui"]
	path = submodules/logos-accounts-ui
	url = https://github.com/logos-co/logos-accounts-ui
	branch = master

